{
  "schema_version": 1,
  "timezones": {
    "et": "America/New_York",
    "wat": "Africa/Lagos"
  },
  "sources": {
    "fred_releases": {
      "name": "FRED release dates API",
      "url": "https://api.stlouisfed.org/fred/releases/dates",
      "documentation_url": "https://fred.stlouisfed.org/docs/api/fred/releases_dates.html"
    },
    "federal_reserve_fomc": {
      "name": "Federal Reserve FOMC calendar",
      "url": "https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm"
    }
  },
  "history": {
    "start_date": "2026-01-01",
    "max_fred_pages": 20,
    "fred_page_size": 1000,
    "notes": "Phase 2 starts with the current calendar year to keep the free FRED API pull bounded. Extend only by changing this file and rerunning the same pipeline."
  },
  "gold_price": {
    "provider": "Yahoo Finance via yfinance",
    "symbol": "GC=F",
    "instrument_label": "COMEX gold futures front-month proxy; not spot XAUUSD",
    "source_url": "https://finance.yahoo.com/quote/GC=F/history",
    "hourly_interval": "1h",
    "daily_interval": "1d",
    "hourly_history_limit_days": 730,
    "adjustment": "unadjusted OHLC close",
    "notes": "XAUUSD=X was checked and returned no Yahoo Finance price data in this run, so GC=F is used only as a clearly labeled free gold-price proxy."
  },
  "signal_engine": {
    "version": 1,
    "score": {
      "buy_min": 2,
      "sell_max": -2,
      "minimum_votes": 3,
      "maximum_missing_fraction": 0.4,
      "tie_behavior": "UNSURE"
    },
    "lock": {
      "minutes_before_release": 60
    },
    "data": {
      "source": "FRED series observations",
      "observation_rule": "Use the latest observation strictly available by the cutoff vintage; never forward-fill missing values.",
      "historical_vintage_rule": "For historical reconstruction, request the FRED vintage from the calendar day before the release to avoid using same-day release information.",
      "max_staleness_days": 90,
      "revised_data_warning": "A vintage is used when FRED supplies it, but FRED vintages and release timestamps are not a substitute for a licensed real-time consensus feed."
    },
    "indicator_catalog": {
      "PAYEMS": {"title": "All Employees, Total Nonfarm", "frequency": "Monthly", "units": "Thousands of Persons", "verified_at": "2026-11-10"},
      "UNRATE": {"title": "Unemployment Rate", "frequency": "Monthly", "units": "Percent", "verified_at": "2026-11-10"},
      "CES0500000003": {"title": "Average Hourly Earnings of All Employees, Total Private", "frequency": "Monthly", "units": "Dollars per Hour", "verified_at": "2026-11-10"},
      "ICSA": {"title": "Initial Claims", "frequency": "Weekly, Ending Saturday", "units": "Number", "verified_at": "2026-11-10"},
      "JTSJOL": {"title": "Job Openings: Total Nonfarm", "frequency": "Monthly", "units": "Level in Thousands", "verified_at": "2026-11-10"},
      "CPIAUCSL": {"title": "Consumer Price Index: All Items", "frequency": "Monthly", "units": "Index 1982-1984=100", "verified_at": "2026-11-10"},
      "CPILFESL": {"title": "Consumer Price Index: Less Food and Energy", "frequency": "Monthly", "units": "Index 1982-1984=100", "verified_at": "2026-11-10"},
      "PPIFIS": {"title": "Producer Price Index: Final Demand", "frequency": "Monthly", "units": "Index Nov 2009=100", "verified_at": "2026-11-10"},
      "PPIFES": {"title": "Producer Price Index: Final Demand Less Foods and Energy", "frequency": "Monthly", "units": "Index Apr 2010=100", "verified_at": "2026-11-10"},
      "IR": {"title": "Import Price Index: All Commodities", "frequency": "Monthly", "units": "Index 2000=100", "verified_at": "2026-11-10"},
      "DCOILWTICO": {"title": "Crude Oil Prices: West Texas Intermediate", "frequency": "Daily", "units": "Dollars per Barrel", "verified_at": "2026-11-10"},
      "GASREGW": {"title": "US Regular All Formulations Gas Price", "frequency": "Weekly, Ending Monday", "units": "Dollars per Gallon", "verified_at": "2026-11-10"},
      "PCEPI": {"title": "Personal Consumption Expenditures: Chain-type Price Index", "frequency": "Monthly", "units": "Index 2017=100", "verified_at": "2026-11-10"},
      "PCEPILFE": {"title": "Personal Consumption Expenditures Excluding Food and Energy", "frequency": "Monthly", "units": "Index 2017=100", "verified_at": "2026-11-10"},
      "FEDFUNDS": {"title": "Federal Funds Effective Rate", "frequency": "Monthly", "units": "Percent", "verified_at": "2026-11-10"},
      "DGS2": {"title": "2-Year Treasury Constant Maturity", "frequency": "Daily", "units": "Percent", "verified_at": "2026-11-10"},
      "SOFR": {"title": "Secured Overnight Financing Rate", "frequency": "Daily", "units": "Percent", "verified_at": "2026-11-10"}
    },
    "rules": {
      "nfp": [
        {"series_id": "PAYEMS", "method": "delta", "lookback": 1, "threshold": 100, "buy_when": "negative", "label": "Payroll growth cooled"},
        {"series_id": "UNRATE", "method": "delta", "lookback": 1, "threshold": 0.1, "buy_when": "positive", "label": "Unemployment rose"},
        {"series_id": "CES0500000003", "method": "delta", "lookback": 1, "threshold": 0.05, "buy_when": "positive", "label": "Hourly earnings rose"},
        {"series_id": "ICSA", "method": "delta", "lookback": 4, "threshold": 10000, "buy_when": "positive", "label": "Claims pressure rose"},
        {"series_id": "JTSJOL", "method": "delta", "lookback": 1, "threshold": 100, "buy_when": "negative", "label": "Job openings fell"}
      ],
      "cpi": [
        {"series_id": "CPIAUCSL", "method": "delta", "lookback": 12, "threshold": 0.2, "buy_when": "positive", "label": "Headline inflation rose"},
        {"series_id": "CPILFESL", "method": "delta", "lookback": 12, "threshold": 0.15, "buy_when": "positive", "label": "Core inflation rose"},
        {"series_id": "PPIFES", "method": "delta", "lookback": 12, "threshold": 0.2, "buy_when": "positive", "label": "Core producer prices rose"},
        {"series_id": "IR", "method": "delta", "lookback": 12, "threshold": 0.2, "buy_when": "positive", "label": "Import prices rose"},
        {"series_id": "GASREGW", "method": "delta", "lookback": 4, "threshold": 0.05, "buy_when": "positive", "label": "Gasoline prices rose"}
      ],
      "ppi": [
        {"series_id": "PPIFIS", "method": "delta", "lookback": 12, "threshold": 0.2, "buy_when": "positive", "label": "Final demand PPI rose"},
        {"series_id": "PPIFES", "method": "delta", "lookback": 12, "threshold": 0.2, "buy_when": "positive", "label": "Core final demand PPI rose"},
        {"series_id": "DCOILWTICO", "method": "delta", "lookback": 20, "threshold": 3, "buy_when": "positive", "label": "WTI rose"},
        {"series_id": "GASREGW", "method": "delta", "lookback": 4, "threshold": 0.05, "buy_when": "positive", "label": "Gasoline prices rose"}
      ],
      "fomc": [
        {"series_id": "FEDFUNDS", "method": "delta", "lookback": 1, "threshold": 0.1, "buy_when": "negative", "label": "Effective policy rate fell"},
        {"series_id": "DGS2", "method": "delta", "lookback": 10, "threshold": 0.1, "buy_when": "negative", "label": "Two-year yield fell"},
        {"series_id": "SOFR", "method": "delta", "lookback": 10, "threshold": 0.1, "buy_when": "negative", "label": "Funding rate fell"}
      ]
    }
  },
  "track_record": {
    "eligibility": "Only signals captured while locked_pre_release are eligible for the immutable public record; historical_reconstruction records remain research-only.",
    "append_only": true,
    "unsure_policy": "UNSURE-skipped is retained and excluded from directional win-rate N."
  },
  "chaining": {
    "max_gap_days": 45,
    "pairing": "Chronological consecutive immutable locked records within the configured gap.",
    "chain_win_definition": "A chain is directional only when both component records are WIN or LOSS; the current record determines the chain result."
  },
  "releases": [
    {
